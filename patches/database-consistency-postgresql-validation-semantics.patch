index 0000000000000000000000000000000000000000..e1a4d4d222a46d56a97c136e8f37c68948e556fa
--- /dev/null
+++ b/spec/checkers/jsonb_text_index_checker_spec.rb
@@ -0,0 +1,85 @@
+# frozen_string_literal: true
+
+RSpec.describe DatabaseConsistency::Checkers::UniqueIndexChecker, :sqlite do
+  let(:klass) { define_class }
+  let(:keys) { %w[transaction_public_id halt_generation] }
+  let(:validator) do
+    Struct.new(:kind, :attributes, :options).new(
+      :jsonb_text_uniqueness, [:context], { keys: keys, where: { event_id: 18 } }
+    )
+  end
+  let(:columns) { "((context ->> 'transaction_public_id'::text)), ((context ->> 'halt_generation'::text))" }
+  let(:predicate) { '(event_id = 18)' }
+  let(:index) do
+    ActiveRecord::ConnectionAdapters::IndexDefinition.new(
+      'entities', 'expression_identity', true, columns, where: predicate
+    )
+  end
+
+  before do
+    define_database_with_entity do |table|
+      table.text :context
+      table.integer :event_id
+    end
+    allow(klass).to receive(:validators).and_return([validator])
+  end
+
+  def check(index, klass)
+    described_class.new(klass, index).report(catch_errors: false).status
+  end
+
+  it 'recognizes the same JSON text expressions and partial predicate' do
+    expect(check(index, klass)).to eq(:ok)
+  end
+
+  it 'rejects different keys including case changes and extra expressions' do
+    [
+      "(context ->> 'transaction_public_id'), (context ->> 'HALT_generation')",
+      "(context ->> 'transaction_public_id'), (context ->> 'halt_generation'), (context ->> 'other')",
+      "(other ->> 'transaction_public_id'), (context ->> 'halt_generation')"
+    ].each do |different_columns|
+      different = ActiveRecord::ConnectionAdapters::IndexDefinition.new(
+        'entities', 'different', true, different_columns, where: predicate
+      )
+      expect(check(different, klass)).to eq(:fail)
+    end
+  end
+
+  it 'rejects missing, different, or more restrictive partial predicates' do
+    [nil, '(event_id = 19)', '(event_id = 18 AND active = 1)'].each do |different_predicate|
+      different = ActiveRecord::ConnectionAdapters::IndexDefinition.new(
+        'entities', 'different', true, columns, where: different_predicate
+      )
+      expect(check(different, klass)).to eq(:fail)
+    end
+  end
+
+  it 'does not accept a validator with an additional conditional guard' do
+    [:if, :unless, :on, :except_on].product([:guarded, false, nil]).each do |guard, value|
+      guarded = Struct.new(:kind, :attributes, :options).new(
+        :jsonb_text_uniqueness, [:context], { keys: keys, where: { event_id: 18 }, guard => value }
+      )
+      allow(klass).to receive(:validators).and_return([guarded])
+      expect(check(index, klass)).to eq(:fail)
+    end
+  end
+
+  it 'rejects explicit expression collations or operator classes it cannot establish as equivalent' do
+    [
+      "(context ->> 'transaction_public_id') COLLATE \"C\", (context ->> 'halt_generation')",
+      "(context ->> 'transaction_public_id') text_pattern_ops, (context ->> 'halt_generation')"
+    ].each do |different_columns|
+      different = ActiveRecord::ConnectionAdapters::IndexDefinition.new(
+        'entities', 'different', true, different_columns, where: predicate
+      )
+      expect(check(different, klass)).to eq(:fail)
+    end
+  end
+
+  it 'does not treat NULLS NOT DISTINCT as equivalent to a validator that permits SQL NULL' do
+    different = ActiveRecord::ConnectionAdapters::IndexDefinition.new(
+      'entities', 'different', true, columns, where: predicate, nulls_not_distinct: true
+    )
+    expect(check(different, klass)).to eq(:fail)
+  end
+end
