@@ -0,0 +1,38 @@
+# frozen_string_literal: true
+
+RSpec.describe DatabaseConsistency::Checkers::MissingUniqueIndexChecker, :sqlite do
+  let(:klass) { define_class }
+  let(:validator) do
+    Struct.new(:kind, :attributes, :options).new(
+      :jsonb_text_uniqueness, [:context], { keys: %w[transaction_public_id halt_generation], where: { event_id: 18 } }
+    )
+  end
+  let(:checker) { described_class.new(klass, :context, validator) }
+
+  before do
+    define_database_with_entity do |table|
+      table.text :context
+      table.integer :event_id
+    end
+  end
+
+  it 'reports a missing unique index for the declared expression validation' do
+    expect(checker.report(catch_errors: false).status).to eq(:fail)
+  end
+
+  it 'accepts a matching unique expression index with the same predicate' do
+    ActiveRecord::Base.connection.execute(<<~SQL)
+      CREATE UNIQUE INDEX expression_identity ON entities
+      ((context ->> 'transaction_public_id'), (context ->> 'halt_generation')) WHERE event_id = 18
+    SQL
+    expect(checker.report(catch_errors: false).status).to eq(:ok)
+  end
+
+  it 'rejects an index with a different predicate' do
+    ActiveRecord::Base.connection.execute(<<~SQL)
+      CREATE UNIQUE INDEX expression_identity ON entities
+      ((context ->> 'transaction_public_id'), (context ->> 'halt_generation')) WHERE event_id = 19
+    SQL
+    expect(checker.report(catch_errors: false).status).to eq(:fail)
+  end
+end
