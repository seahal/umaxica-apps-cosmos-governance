@@ -0,0 +1,76 @@
+# frozen_string_literal: true
+
+RSpec.describe DatabaseConsistency::Helper, :sqlite, :mysql, :postgresql do
+  describe '.conditions_match_index?' do
+    it 'accepts a NOT NULL predicate covering every nonblank scalar value checked by the validator' do
+      validator = ActiveRecord::Validations::UniquenessValidator.new(
+        attributes: [:digest], class: ActiveRecord::Base, allow_blank: true
+      )
+
+      expect(described_class.conditions_match_index?(ActiveRecord::Base, :digest, validator, '("digest" IS NOT NULL)')).to eq(true)
+    end
+
+    it 'retains exact allow_nil coverage without introducing a NULL uniqueness requirement' do
+      validator = ActiveRecord::Validations::UniquenessValidator.new(
+        attributes: [:digest], class: ActiveRecord::Base, allow_nil: true
+      )
+
+      expect(described_class.conditions_match_index?(ActiveRecord::Base, :digest, validator, 'digest IS NOT NULL')).to eq(true)
+    end
+
+    it 'does not infer scoped NULL equivalence from a stronger scalar guard' do
+      validator = ActiveRecord::Validations::UniquenessValidator.new(
+        attributes: [:digest], class: ActiveRecord::Base, scope: :owner_id, allow_blank: true
+      )
+
+      expect(described_class.conditions_match_index?(ActiveRecord::Base, :digest, validator, 'digest IS NOT NULL')).to eq(false)
+    end
+
+    it 'rejects a partial index on another nullable column' do
+      validator = ActiveRecord::Validations::UniquenessValidator.new(
+        attributes: [:digest], class: ActiveRecord::Base, allow_blank: true
+      )
+
+      expect(described_class.conditions_match_index?(ActiveRecord::Base, :digest, validator, 'other_digest IS NOT NULL')).to eq(false)
+    end
+
+    it 'rejects a partial index excluding a checked value' do
+      validator = ActiveRecord::Validations::UniquenessValidator.new(
+        attributes: [:digest], class: ActiveRecord::Base, allow_blank: true
+      )
+
+      expect(described_class.conditions_match_index?(ActiveRecord::Base, :digest, validator, "digest IS NOT NULL AND digest != 'reserved'")).to eq(false)
+    end
+
+    it 'rejects an unrelated lifecycle predicate' do
+      validator = ActiveRecord::Validations::UniquenessValidator.new(
+        attributes: [:digest], class: ActiveRecord::Base, allow_blank: true
+      )
+
+      expect(described_class.conditions_match_index?(ActiveRecord::Base, :digest, validator, 'released_at IS NULL')).to eq(false)
+    end
+
+    it 'does not replace explicit domain conditions with a scalar blank guard' do
+      validator = ActiveRecord::Validations::UniquenessValidator.new(
+        attributes: [:digest], class: ActiveRecord::Base, allow_blank: true, conditions: -> { where(active: true) }
+      )
+
+      expect(described_class.conditions_match_index?(ActiveRecord::Base, :digest, validator, 'digest IS NOT NULL')).to eq(false)
+    end
+
+    it 'does not replace an unresolved explicit predicate with an allow_nil guard' do
+      validator = ActiveRecord::Validations::UniquenessValidator.new(
+        attributes: [:digest], class: ActiveRecord::Base, allow_nil: true,
+        conditions: -> { raise ArgumentError, 'unsupported predicate' }
+      )
+
+      expect(described_class.conditions_match_index?(ActiveRecord::Base, :digest, validator, 'digest IS NOT NULL')).to eq(false)
+    end
+
+    it 'does not infer a nil guard for an unconditional validator' do
+      validator = ActiveRecord::Validations::UniquenessValidator.new(attributes: [:digest], class: ActiveRecord::Base)
+
+      expect(described_class.conditions_match_index?(ActiveRecord::Base, :digest, validator, 'digest IS NOT NULL')).to eq(false)
+    end
+  end
+end
