+      # A projection guard skips validation only when the column was not selected. It cannot
+      # permit NULL for a loaded attribute. Recognize only the complete, literal lambda body;
+      # arbitrary conditions remain weak and ambiguous source locations fail closed.
+      def projected_attribute_guard?(validator)
+        return false unless defined?(Prism)
+        return false unless model.instance_method(:has_attribute?).owner == ActiveRecord::AttributeMethods
+        return false unless validator.options.slice(*WEAK_OPTIONS).keys == [:if]
+
+        condition = validator.options[:if]
+        return false unless condition.is_a?(Proc) && condition.lambda?
+
+        file, line = condition.source_location
+        return false unless file && File.file?(file)
+
+        projection_lambda_body(file, line)
+      end
+
+      def projection_lambda_body(file, line)
+        nodes = [Prism.parse_file(file).value]
+        candidates = []
+        until nodes.empty?
+          node = nodes.pop
+          candidates << node if node.is_a?(Prism::LambdaNode) && node.location.start_line == line
+          nodes.concat(node.compact_child_nodes)
+        end
+        return false unless candidates.one?
+
+        lambda_node = candidates.first
+        return false unless lambda_node.parameters.nil? && lambda_node.body&.body&.one?
+
+        literal_attribute_guard?(lambda_node.body.body.first)
+      end
+
+      def literal_attribute_guard?(call)
+        return false unless call.is_a?(Prism::CallNode) && call.name == :has_attribute? &&
+          call.receiver.nil? && call.block.nil?
+
+        arguments = call.arguments&.arguments
+        return false unless arguments&.one? && arguments.first.is_a?(Prism::SymbolNode)
+
+        arguments.first.unescaped == attribute.to_s
+      end
+
       def belongs_to_required_validates_foreign_key_disabled?
         ActiveRecord.version >= Gem::Version.new('7.1.0') &&
           !ActiveRecord.belongs_to_required_validates_foreign_key
